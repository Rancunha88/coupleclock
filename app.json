{
  "expo": {
    "name": "CoupleClock",
    "slug": "love-app",
    "version": "1.0.0",
    "scheme": "coupleclock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ran88.loveapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5c0016",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fcb2e0e1-32ef-4de4-aee1-dfe4450590aa"
      }
    },
    "owner": "ran88",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "CoupleClock uses your photo library so you can choose a picture of you and your partner. For example, the photo you pick is shown at the top of the home screen next to your relationship counter. The photo stays on your device and is never uploaded.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DaysTogether",
              "displayName": "Days Together",
              "description": "Your days-together count at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            }
          ]
        }
      ]
    ]
  }
}
